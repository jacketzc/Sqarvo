<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xunit 测试工程：在 Linux 上即可运行（Core 无 WinUI 依赖），并且包含对真后端进程的集成测试。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sqarvo.Core.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      本机（以及未来的 Linux CI）可能只装了更新的 .NET 运行时；测试宿主允许前滚到更高主版本，
      这样 net8.0 测试在只装 .NET 10 运行时的机器上也能跑。被测的 Core 仍是 net8.0。
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sqarvo.Core\Sqarvo.Core.csproj" />
  </ItemGroup>

  <!--
    Windows 前端里**不含 WinUI 类型**的那部分（连接配置、错误分类、状态快照）以源码方式编进测试
    工程：它们只用到 System.Text.Json / System.IO 与 Sqarvo.Core，所以在 Linux 上可以真跑，
    connections.json 的 schema、身份去重与「只存 credential_ref」这条安全约束就有回归测试。
    WinUI 工程本身（net8.0-windows + XAML）在 Linux 上无法编译，不能直接被引用；
    等 Windows CI 有测试工程后可以把这些用例搬过去。
  -->
  <ItemGroup>
    <Compile Include="..\Sqarvo.Windows\Connections\ConnectionProfile.cs" Link="Windows\Connections\ConnectionProfile.cs" />
    <Compile Include="..\Sqarvo.Windows\Connections\ConnectionStore.cs" Link="Windows\Connections\ConnectionStore.cs" />
    <Compile Include="..\Sqarvo.Windows\Connections\ConnectionForm.cs" Link="Windows\Connections\ConnectionForm.cs" />
    <Compile Include="..\Sqarvo.Windows\Connections\TlsModeChoice.cs" Link="Windows\Connections\TlsModeChoice.cs" />
    <Compile Include="..\Sqarvo.Windows\Workspace\BackendState.cs" Link="Windows\Workspace\BackendState.cs" />
    <Compile Include="..\Sqarvo.Windows\Workspace\SqarvoFailure.cs" Link="Windows\Workspace\SqarvoFailure.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>