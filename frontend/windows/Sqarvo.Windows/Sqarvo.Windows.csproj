<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Sqarvo.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 未打包应用没有清单图标声明：exe 图标来自 ApplicationIcon，标题栏/任务栏由
         App.xaml.cs 的 AppWindow.SetIcon 指到同一个 .ico（两处必须是同一份文件）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
  </ItemGroup>

  <!--
    通信与进程层全部在 Sqarvo.Core（net8.0，无 WinUI 依赖），这样它能在 Linux 上编译与测试。
    注意：这里**不再**生成 protobuf/gRPC 存根——proto 的生成统一归 Sqarvo.Core，
    两处各生成一份会产生同名类型。
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sqarvo.Core\Sqarvo.Core.csproj" />
  </ItemGroup>

  <!--
    布局度量真值：构建期从 docs/ui-specification/metrics.toml 生成 Metrics.g.cs（ADR 0026 决策 3）。
    生成文件放 obj/ 下（不提交）；生成失败或三档不变量不成立都会让构建变红——
    宁可构建失败，也不要三端静默漂移 1px。
  -->
  <PropertyGroup>
    <MetricsTomlPath>$(MSBuildProjectDirectory)\..\..\..\docs\ui-specification\metrics.toml</MetricsTomlPath>
    <MetricsGenerator>$(MSBuildProjectDirectory)\..\tools\gen-metrics.ps1</MetricsGenerator>
    <MetricsGeneratedFile>$(MSBuildProjectDirectory)\obj\gen\Metrics.g.cs</MetricsGeneratedFile>
  </PropertyGroup>

  <!--
    生成必须在编译链的最前面：挂在 BeforeCompile 上时，干净检出（obj/ 为空）的首次构建
    里 CSC 会先跑并报 CS2001「找不到 Metrics.g.cs」——BeforeCompile 在 WinUI 的构建图里
    不保证先于 XAML 编译器与 CSC 求值。挂 PrepareForBuild 是构建图里最早的一步，稳定。
  -->
  <Target Name="GenerateMetrics" BeforeTargets="PrepareForBuild" Inputs="$(MetricsTomlPath);$(MetricsGenerator)" Outputs="$(MetricsGeneratedFile)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MetricsGenerator)&quot; -TomlPath &quot;$(MetricsTomlPath)&quot; -OutPath &quot;$(MetricsGeneratedFile)&quot;" />
  </Target>

  <!--
    生成文件在**求值期**就进 Compile 列表：XAML 编译器（MarkupCompilePass1）与 CoreCompile
    都按求值期的 @(Compile) 工作，在目标里追加会让 XAML 编译器拿不到项目内类型
    （WMC9999）。文件由上面的 GenerateMetrics 在编译前写好，obj/ 已被 .gitignore 覆盖。
  -->
  <ItemGroup>
    <Compile Include="$(MetricsGeneratedFile)" />
  </ItemGroup>

</Project>