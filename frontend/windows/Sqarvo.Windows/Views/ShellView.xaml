<?xml version="1.0" encoding="utf-8"?>
<!--
#164 的六区域外壳 + #169 的后端接线（连接面）+ #168 的可拖面板（窗口层）。

    #169 起：菜单「文件 → 新建连接…」与工具条「连接」的启用态、状态栏两行、对象树的连接层
    全部由 code-behind 从 BackendState 这一份快照渲染（见 ShellView.ApplyBackendState）；
    未实现的入口保持禁用，原因逐条写在 tooltip 里。
    #168 起：侧栏与信息面板可拖（两条分隔线同时是拖动条），拖动范围与默认值全部来自 Metrics。
    本文件里只有启用态、文案与两条拖动条，布局尺寸依旧在 code-behind 里从 Metrics 取。

    区域与宿主控件严格按 docs/ui-specification/workspace-model.md §8 的 Windows 列：
    系统标题栏（AppWindow）+ 窗口内菜单行（MenuBar）→ 主工具条（自绘 Grid：动作按钮 + 种类入口）→
    对象树（TreeView）→ 工作区（TabView）→ 状态栏（自绘两行）→ 信息面板（SplitView 右panel）。

    尺寸：高度/字号全用 {StaticResource Size.*}；宽度这类 GridLength / 结构体在 code-behind 里
    从 Metrics 取。颜色只用 ThemeResource，XAML 里没有 #RRGGBB。
-->
<UserControl
    x:Class="Sqarvo.Windows.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <UserControl.Resources>
        <!--
            树行高来自度量（row_height_tree 24 / 30 / 36）。只加一个 MinHeight setter：
            WinUI 3 的显式 Style 只覆盖同名 setter，模板仍由默认样式提供，所以不需要
            BasedOn（也就不会因为默认样式键改名而在启动时炸）。
        -->
        <Style x:Key="SqarvoTreeRowStyle" TargetType="TreeViewItem">
            <!-- 行高 row_height_tree（24 / 30 / 36）：与 Linux 的 tree_row 同一档 -->
            <Setter Property="MinHeight" Value="{StaticResource Size.RowHeightTree}" />
            <!-- 行字号 font_ui（12 / 15 / 18）：树行原本吃框架默认 14，比中央空态主标题（font_title 13）
                 还大一档，标题反而「弱于树」。取 font_ui 后层级才成立。
                 层级缩进由 TreeViewItem 的默认模板按深度给（框架行为，不覆盖模板）。 -->
            <Setter Property="FontSize" Value="{StaticResource Size.FontUi}" />
        </Style>

        <!--
            状态栏行操作 / 搜索按钮：命中区固定 icon_button_width × icon_button_height（≥ min_target
            的同一档），所以 6 个行操作 + 搜索的点击范围完全一致。
            MinHeight 必须显式压到同一个值：WinUI 的 Button 默认 MinHeight 是 32，只写 Height 会被它顶回去。
            禁用态与说明文字同一种灰（Tokens.xaml 的 ButtonForegroundDisabled 别名），状态栏里不出现第三档灰。
        -->
        <Style x:Key="SqarvoStatusIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="{StaticResource Size.IconButtonWidth}" />
            <Setter Property="Height" Value="{StaticResource Size.IconButtonHeight}" />
            <Setter Property="MinWidth" Value="{StaticResource Size.IconButtonWidth}" />
            <Setter Property="MinHeight" Value="{StaticResource Size.IconButtonHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SqarvoAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 工具条下边线（1px，不参与缩放） -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- 状态栏上边线（1px，不参与缩放） -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 区域 01：窗口内菜单行（Windows 的系统标题栏由 AppWindow 提供，不在这里自绘） -->
        <Border
            x:Name="MenuBand"
            Grid.Row="0"
            Background="{ThemeResource SqarvoBandBrush}">
            <MenuBar x:Name="MainMenu" AutomationProperties.Name="主菜单">
                <MenuBarItem Title="文件">
                    <!-- 启用态由 BackendState.IsReady 决定（ShellView.ApplyBackendState），tooltip 在 code-behind 逐项说明 -->
                    <MenuFlyoutItem x:Name="MenuNewConnection" Text="新建连接…" />
                    <MenuFlyoutItem x:Name="MenuNewQueryTab" Text="新建查询标签" IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="MenuQuit" Text="退出" />
                </MenuBarItem>
                <MenuBarItem Title="表">
                    <MenuFlyoutItem x:Name="MenuExportCsv" Text="导出 CSV…" IsEnabled="False" />
                </MenuBarItem>
                <MenuBarItem Title="帮助">
                    <MenuFlyoutItem x:Name="MenuAbout" Text="关于 Squarvo" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <!--
            区域 02：主工具条。

            形态与 Linux 客户端的 Toolbar（shell.rs `Toolbar::new`）同构：
            左动作组（连接 = 主操作 · 新建查询 = 次要）→ 1px 竖分隔线 → 四个种类入口 → 余下留白。

            为什么是 Button + Border + TextBlock 而不是 CommandBar / AppBarButton / ToggleButton：
            #170 把整块换成 CommandBar + AppBarButton + ToggleButton 之后在真机上秒级崩溃
            （0xc000027b，5/5 与 3/3 两轮），整块已回退。这里只用最朴素的原语：
            Button 提供命中区、Tab 焦点与启用态（code-behind 仍在改 ButtonConnect.IsEnabled，
            所以两个动作必须是 Button 而不是 Border），颜色与字形落在 Border / TextBlock 上；
            种类入口不接动作、只表达「现在列的是哪一类」，用 Border + TextBlock。

            图标是 Segoe Fluent Icons 的**字形**（TextBlock + FontFamily），不是 FontIcon：
            字形只是一个字符，不额外实例化控件。高度 / 字号 / 内边距全部来自 Metrics
            （高度与字号用 Size.*，Padding / CornerRadius 这类结构体在 ShellView.Chrome.cs 里取）。
        -->
        <Border
            x:Name="ToolbarBand"
            Grid.Row="1"
            Background="{ThemeResource SqarvoSurfaceBrush}"
            Height="{StaticResource Size.ToolbarHeight}">
            <Grid x:Name="MainToolbar" AutomationProperties.Name="主工具条">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="ToolbarActions"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource Size.InspectorGap}">
                    <!-- 主操作：系统强调色底 + 反白文字。禁用态的底色由 Button 的模板视觉状态接管
                         （VisualState 的 setter 会盖掉这里的本地值），所以没后端时它自然变灰。 -->
                    <Button
                        x:Name="ButtonConnect"
                        Height="{StaticResource Size.BadgeMinHeight}"
                        MinHeight="{StaticResource Size.SecondaryMinHeight}"
                        MinWidth="0"
                        Padding="0"
                        Background="Transparent"
                        AutomationProperties.Name="连接"
                        ToolTipService.ToolTip="打开连接对话框（Ctrl+N）">
                        <!-- 强调色必须落在内层 Border 上：Button 模板的 Normal 视觉态会用 setter 盖掉
                             Button.Background 的本地值（真机上就是「设了 accent 却显示成普通浅色按钮」）。 -->
                        <Border x:Name="ConnectChip" Background="{ThemeResource SqarvoAccentFillBrush}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource Size.GridPaddingEnd}">
                                <TextBlock
                                    FontFamily="Segoe Fluent Icons"
                                    Text="&#xE71B;"
                                    FontSize="{StaticResource Size.FontUi}"
                                    Foreground="{ThemeResource SqarvoOnAccentTextBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="连接"
                                    FontSize="{StaticResource Size.FontUi}"
                                    Foreground="{ThemeResource SqarvoOnAccentTextBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 次要动作：中性底（透明）+ 主文字色，与种类入口同一套 flat 形态。 -->
                    <Button
                        x:Name="ButtonNewQuery"
                        Height="{StaticResource Size.BadgeMinHeight}"
                        MinHeight="{StaticResource Size.SecondaryMinHeight}"
                        MinWidth="0"
                        Padding="0"
                        IsEnabled="False"
                        Background="{ThemeResource SqarvoTransparentBrush}"
                        AutomationProperties.Name="新建查询"
                        ToolTipService.ToolTip="新建查询标签（Ctrl+T）">
                        <Border x:Name="NewQueryChip" Background="Transparent">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource Size.GridPaddingEnd}">
                                <TextBlock
                                    FontFamily="Segoe Fluent Icons"
                                    Text="&#xE710;"
                                    FontSize="{StaticResource Size.FontUi}"
                                    Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="新建查询"
                                    FontSize="{StaticResource Size.FontUi}"
                                    Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- 左组与种类入口之间的 1px 竖分隔线：视觉线 1px、命中区/间距取 inspector_gap。
                     不用 Border.BorderThickness（Thickness 无法从 double 资源转），用 Rectangle。 -->
                <Grid Grid.Column="1" Width="{StaticResource Size.InspectorGap}">
                    <Rectangle
                        Width="{StaticResource Size.BorderWidthPxNeverScaled}"
                        Height="{StaticResource Size.IconButtonHeight}"
                        Fill="{ThemeResource SqarvoDividerBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 种类入口：选中 = 浅填充底 + 文字加粗（SemiBold），未选中 = 透明底 + 次要色弱化文字。
                     当前静态标在 Tables（与 Linux 截图一致：Objects 页列的是表）；种类切换接线后
                     由 code-behind 改这四个 Border 的 Background 与文字字重，不需要新控件类型。 -->
                <StackPanel
                    x:Name="ToolbarKinds"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource Size.GridPaddingEnd}">
                    <Border
                        x:Name="ButtonTables"
                        Height="{StaticResource Size.IconButtonHeight}"
                        Background="{ThemeResource SqarvoSelectionBrush}"
                        AutomationProperties.Name="Tables">
                        <TextBlock
                            Text="Tables"
                            FontSize="{StaticResource Size.FontUi}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        x:Name="ButtonViews"
                        Height="{StaticResource Size.IconButtonHeight}"
                        Background="{ThemeResource SqarvoTransparentBrush}"
                        AutomationProperties.Name="Views">
                        <TextBlock
                            Text="Views"
                            FontSize="{StaticResource Size.FontUi}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        x:Name="ButtonFunctions"
                        Height="{StaticResource Size.IconButtonHeight}"
                        Background="{ThemeResource SqarvoTransparentBrush}"
                        AutomationProperties.Name="Functions">
                        <TextBlock
                            Text="Functions"
                            FontSize="{StaticResource Size.FontUi}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        x:Name="ButtonQueries"
                        Height="{StaticResource Size.IconButtonHeight}"
                        Background="{ThemeResource SqarvoTransparentBrush}"
                        AutomationProperties.Name="Queries">
                        <TextBlock
                            Text="Queries"
                            FontSize="{StaticResource Size.FontUi}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具条下边线：与 Linux 的 `.sqarvo-toolbar` border-bottom 同一口径，
             厚度取 BorderWidthPxNeverScaled（1px，不随密度档变粗）。 -->
        <Rectangle
            Grid.Row="2"
            Height="{StaticResource Size.BorderWidthPxNeverScaled}"
            Fill="{ThemeResource SqarvoDividerBrush}"
            HorizontalAlignment="Stretch" />

        <!--
            区域 03 / 04 / 06：树 + 工作区 + 右侧信息面板。

            侧栏与信息面板都可拖：两条分隔线本身就是拖动条（Thumb，不是第三方 GridSplitter——
            项目不引入新依赖）。可拖区间来自 metrics 的 sidebar_min/max 与 inspector_min/max，
            拖动结束由窗口层归一化写回 window.json。
        -->
        <SplitView
            x:Name="InspectorSplit"
            Grid.Row="3"
            PanePlacement="Right"
            DisplayMode="Inline"
            IsPaneOpen="True">
            <SplitView.Pane>
                <Grid Background="{ThemeResource SqarvoBandBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="InspectorTitle"
                        Grid.Row="0"
                        Text="信息面板"
                        FontSize="{StaticResource Size.FontTitle}"
                        Foreground="{ThemeResource SqarvoTextPrimaryBrush}" />
                    <Rectangle
                        Grid.Row="1"
                        Height="{StaticResource Size.BorderWidthPxNeverScaled}"
                        Fill="{ThemeResource SqarvoDividerBrush}" />
                    <!-- 启动态内容区留白（规范 §5：不写「没有选中对象」这类说明文字） -->
                    <Grid Grid.Row="2" x:Name="InspectorBody" AutomationProperties.Name="信息面板内容" />
                </Grid>
            </SplitView.Pane>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 区域 03：对象树（侧栏）。没有搜索框、没有页脚按钮，树本身即侧栏。 -->
                <Grid Grid.Column="0" Background="{ThemeResource SqarvoBandBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TreeView
                        x:Name="ObjectTree"
                        AutomationProperties.Name="对象树"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource SqarvoTreeRowStyle}"
                        CanDragItems="False"
                        CanReorderItems="False"
                        Expanding="OnTreeExpanding"
                        Collapsed="OnTreeCollapsed">
                        <TreeView.RootNodes>
                            <TreeViewNode Content="My Connections" IsExpanded="True" HasUnrealizedChildren="False" />
                        </TreeView.RootNodes>
                    </TreeView>
                </Grid>

                <!-- 侧栏分隔线 = 拖动条：命中区取 grid_padding_end，视觉线取不缩放的 1px 描边。 -->
                <Grid Grid.Column="1" Width="{StaticResource Size.GridPaddingEnd}">
                    <Rectangle
                        Width="{StaticResource Size.BorderWidthPxNeverScaled}"
                        Fill="{ThemeResource SqarvoDividerBrush}"
                        HorizontalAlignment="Center" />
                    <primitives:Thumb
                        x:Name="SidebarSplitter"
                        IsTabStop="True"
                        AutomationProperties.Name="调整侧栏宽度"
                        ToolTipService.ToolTip="拖动调整侧栏宽度（←/→ 微调，双击复位）"
                        DragStarted="OnSidebarSplitterDragStarted"
                        DragDelta="OnSidebarSplitterDragDelta"
                        DragCompleted="OnSidebarSplitterDragCompleted"
                        DoubleTapped="OnSidebarSplitterDoubleTapped"
                        KeyDown="OnSidebarSplitterKeyDown">
                        <!-- 透明底才可命中：Thumb 本身没有 Background 属性（UWP/WinUI 的 Control 没有），
                             所以给一个只有透明 Border 的模板。视觉线是下面那条 1px 描边。 -->
                        <primitives:Thumb.Template>
                            <ControlTemplate TargetType="primitives:Thumb">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>
                </Grid>

                <!-- 区域 04：工作区 -->
                <Grid Grid.Column="2" Background="{ThemeResource SqarvoSurfaceBrush}">
                    <TabView
                        x:Name="WorkspaceTabs"
                        CanDragTabs="False"
                        CanReorderTabs="False"
                        IsAddTabButtonVisible="False"
                        AutomationProperties.Name="工作区标签">
                        <TabView.TabItems>
                            <!--
                                固定的 Objects 页：WinUI 的 TabView 没有 pinned 概念，
                                用 IsClosable=False + 固定首位 + 禁拖 等价实现（不是 API 缺失的将就：
                                它的行为正好是「不能关、不能挪、恒在最左」，切换其它标签时不受影响）。

                                标签内容按 Linux 的 pinned 页形态（theme.rs `.sqarvo-tab-bar tab.pinned`：
                                min-width 84、padding 0、字号 ui）——只显图标 + 短文字，紧凑。
                                图标是 Segoe Fluent Icons 字形（2×2 网格），不是 FontIcon；
                                宽度 / 高度由 ApplyMetrics 从 Metrics.ObjectsMinWidth / TabStripHeight 写。
                                TabView 自身的属性（TabWidthMode / IsAddTabButtonVisible / CanReorderTabs）
                                一律不动：#170 改这几个属性是崩溃边界之一，本片不碰。
                            -->
                            <TabViewItem x:Name="ObjectsTab" IsClosable="False" AutomationProperties.Name="Objects 页">
                                <TabViewItem.Header>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource Size.GridPaddingEnd}">
                                        <TextBlock
                                            FontFamily="Segoe Fluent Icons"
                                            Text="&#xF0E2;"
                                            FontSize="{StaticResource Size.FontUi}"
                                            Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="Objects"
                                            FontSize="{StaticResource Size.FontUi}"
                                            Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <Grid Background="{ThemeResource SqarvoSurfaceBrush}">
                                    <!--
                                        Objects 页（#171）：标题 + 状态行 + 三列表格 + 「加载更多…」。
                                        表头与每一行都由 code-behind 建：列宽是 GridLength，不能从 double
                                        类型的 Size.* 资源直接转换，因此宽度在 ApplyMetrics/ObjectRow 里取
                                        Metrics（row_number_width / column_width / row_height_data）。
                                        颜色只用 ThemeResource（SqarvoDividerBrush / SqarvoTextSecondaryBrush /
                                        SqarvoSelectionBrush），不出现 #RRGGBB。
                                    -->
                                    <Grid x:Name="ObjectsPage">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            x:Name="ObjectsTitle"
                                            Grid.Row="0"
                                            Text="Objects"
                                            FontSize="{StaticResource Size.FontTitle}"
                                            Foreground="{ThemeResource SqarvoTextPrimaryBrush}" />

                                        <!-- 状态行：正在读取… / 已加载 N 个对象 / （这个库里没有这类对象）/ 读取失败…（错误码） -->
                                        <TextBlock
                                            x:Name="ObjectsStatus"
                                            Grid.Row="1"
                                            Visibility="Collapsed"
                                            TextTrimming="CharacterEllipsis"
                                            FontSize="{StaticResource Size.FontStatus}"
                                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}" />

                                        <ScrollViewer
                                            x:Name="ObjectsListScroll"
                                            Grid.Row="2"
                                            IsTabStop="True"
                                            AutomationProperties.Name="Objects 列表"
                                            VerticalScrollBarVisibility="Auto"
                                            VerticalScrollMode="Auto"
                                            HorizontalScrollBarVisibility="Disabled"
                                            KeyDown="OnObjectsKeyDown">
                                            <!-- 表头与数据行共用同一份列定义（三列：行号 / 名称 / 类型），
                                                 列宽来自 Metrics（RowNumberWidth / ColumnWidth / 自动），
                                                 行高 row_height_data；全部在 code-behind 里建。 -->
                                            <Grid x:Name="ObjectsTable" />
                                        </ScrollViewer>

                                        <Button
                                            x:Name="ObjectsLoadMore"
                                            Grid.Row="3"
                                            Content="加载更多…"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Objects 加载更多"
                                            Click="OnObjectsLoadMoreClick" />
                                    </Grid>

                                    <!-- 三态：Disconnected 常显；Loading 是后端握手；Empty 是「没有选中对象」 -->
                                    <StackPanel
                                        x:Name="StateDisconnected"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="{StaticResource Size.InspectorGap}">
                                        <TextBlock
                                            Text="尚未连接数据库"
                                            FontSize="{StaticResource Size.FontTitle}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="用工具条的「连接」保存一条连接；它会作为 My Connections 下的节点出现。"
                                            FontSize="{StaticResource Size.FontStatus}"
                                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="StateLoading"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="{StaticResource Size.InspectorGap}">
                                        <!-- 加载态：不引入 ProgressRing（#170 崩溃排查里它曾被逐个隔离过，
                                             这里用字形「…」+ 文案表达同一件事，少一个控件实例）。 -->
                                        <TextBlock
                                            Text="…"
                                            FontSize="{StaticResource Size.FontTitle}"
                                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="正在连接…"
                                            FontSize="{StaticResource Size.FontUi}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="StateEmpty"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="{StaticResource Size.InspectorGap}">
                                        <TextBlock
                                            Text="没有选中对象"
                                            FontSize="{StaticResource Size.FontTitle}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="在左侧对象树里选中一个库（或它下面的 Tables / Views），这里会列出该库的表或视图。"
                                            FontSize="{StaticResource Size.FontStatus}"
                                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </TabViewItem>
                        </TabView.TabItems>
                    </TabView>
                </Grid>

                <!-- 信息面板分隔线 = 拖动条（面板本体在 SplitView 的右 pane 里）。 -->
                <Grid Grid.Column="3" Width="{StaticResource Size.GridPaddingEnd}">
                    <Rectangle
                        Width="{StaticResource Size.BorderWidthPxNeverScaled}"
                        Fill="{ThemeResource SqarvoDividerBrush}"
                        HorizontalAlignment="Center" />
                    <primitives:Thumb
                        x:Name="InspectorSplitter"
                        IsTabStop="True"
                        AutomationProperties.Name="调整信息面板宽度"
                        ToolTipService.ToolTip="拖动调整信息面板宽度（←/→ 微调，双击复位）"
                        DragStarted="OnInspectorSplitterDragStarted"
                        DragDelta="OnInspectorSplitterDragDelta"
                        DragCompleted="OnInspectorSplitterDragCompleted"
                        DoubleTapped="OnInspectorSplitterDoubleTapped"
                        KeyDown="OnInspectorSplitterKeyDown">
                        <primitives:Thumb.Template>
                            <ControlTemplate TargetType="primitives:Thumb">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>
                </Grid>
            </Grid>
        </SplitView>

        <!--
            区域 05：状态栏，两行（每行 icon_button_height，合起来正好 status_height = 48 / 60 / 72）。
            左列是侧栏的「沟」：对象树搜索框挂在这里（Linux 的 StatusBar::mount_search 同一处），
            与上方对象树同宽；竖分割线与侧栏分栏线同一根轴（宽度由 code-behind 跟随）。

            行 1：左 = 后端状态（已连接 / 连接中 / 未连接 · 驱动 N · 浏览会话 N）；
                  右 = 行操作图标 + 搜索 + 结果行数 + 分页器。
            行 2：左 = SQL 摘要；右 = 会话名 + Last Refresh。
            读数只写真实值：分页器没有数据时写「? / ?」，不写死 0 / 0。
        -->
        <!-- 状态栏上边线：Linux 的 `.sqarvo-status-bar` border-top 同一口径 -->
        <Rectangle
            Grid.Row="4"
            Height="{StaticResource Size.BorderWidthPxNeverScaled}"
            Fill="{ThemeResource SqarvoDividerBrush}"
            HorizontalAlignment="Stretch" />

        <Grid
            x:Name="StatusBand"
            Grid.Row="5"
            Background="{ThemeResource SqarvoBandBrush}"
            Height="{StaticResource Size.StatusHeight}">
            <Grid.ColumnDefinitions>
                <!-- 沟宽跟随侧栏分栏位置（拖分栏线同步），保证竖线与侧栏分隔线在同一根轴上 -->
                <ColumnDefinition x:Name="StatusGutterColumn" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左边沟：对象树搜索框（与树同一列宽，底部贴树）。搜索尚未接线，禁用并给原因。 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBox
                    x:Name="TreeSearchBox"
                    Height="{StaticResource Size.IconButtonHeight}"
                    MinHeight="{StaticResource Size.IconButtonHeight}"
                    IsEnabled="False"
                    FontSize="{StaticResource Size.FontStatus}"
                    PlaceholderText="搜索连接、库、表..."
                    AutomationProperties.Name="搜索连接、库、表" />
            </StackPanel>

            <Rectangle
                Grid.Column="1"
                Width="{StaticResource Size.BorderWidthPxNeverScaled}"
                Fill="{ThemeResource SqarvoDividerBrush}"
                VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 行 1 -->
                <Grid Grid.Row="0" Height="{StaticResource Size.IconButtonHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="StatusLineText"
                        Grid.Column="0"
                        Text="连接中 · 驱动 0 · 浏览会话 0"
                        FontSize="{StaticResource Size.FontStatus}"
                        Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource Size.InspectorGap}">
                        <StackPanel
                            x:Name="RowOps"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource Size.GridPaddingEnd}">
                            <Button x:Name="ButtonRowAdd" Style="{StaticResource SqarvoStatusIconButton}" AutomationProperties.Name="新增行">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="{StaticResource Size.FontUi}" />
                            </Button>
                            <Button x:Name="ButtonRowDelete" Style="{StaticResource SqarvoStatusIconButton}" AutomationProperties.Name="删除选中行">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE738;" FontSize="{StaticResource Size.FontUi}" />
                            </Button>
                            <Button x:Name="ButtonRowApply" Style="{StaticResource SqarvoStatusIconButton}" AutomationProperties.Name="提交变更">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FB;" FontSize="{StaticResource Size.FontUi}" />
                            </Button>
                            <Button x:Name="ButtonRowRevert" Style="{StaticResource SqarvoStatusIconButton}" AutomationProperties.Name="撤销修改">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A7;" FontSize="{StaticResource Size.FontUi}" />
                            </Button>
                            <Button x:Name="ButtonRowRefresh" Style="{StaticResource SqarvoStatusIconButton}" AutomationProperties.Name="刷新">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="{StaticResource Size.FontUi}" />
                            </Button>
                            <Button x:Name="ButtonRowCancel" Style="{StaticResource SqarvoStatusIconButton}" AutomationProperties.Name="取消">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="{StaticResource Size.FontUi}" />
                            </Button>
                        </StackPanel>

                        <!-- 搜索：把焦点交给左下角的对象树搜索框（搜索本身尚未接线，按同一套「禁用 + 原因」处理） -->
                        <Button
                            x:Name="ButtonSearch"
                            Style="{StaticResource SqarvoStatusIconButton}"
                            IsEnabled="False"
                            AutomationProperties.Name="搜索对象树">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="{StaticResource Size.FontUi}" />
                        </Button>

                        <!-- 结果行数（查询页在飞时由 ApplyQueryStatus 写「N 行 / 已取 M 行」） -->
                        <TextBlock
                            x:Name="LastRefreshText"
                            FontSize="{StaticResource Size.FontStatus}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <!-- 分页器：没有分页数据时写「? / ?」，不写死 0 / 0 -->
                        <TextBlock
                            x:Name="PagerText"
                            Text="第 ? / ? 页"
                            FontSize="{StaticResource Size.PagerFont}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 行 2 -->
                <Grid Grid.Row="1" Height="{StaticResource Size.IconButtonHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="SqlSummaryText"
                        Grid.Column="0"
                        Text="SQL: 尚未执行"
                        TextTrimming="CharacterEllipsis"
                        FontSize="{StaticResource Size.FontStatus}"
                        Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource Size.InspectorGap}">
                        <!-- 事务状态（表数据页写：只读 / 自动提交 / 未提交 N 行 / 提交中… / 已回滚） -->
                        <TextBlock
                            x:Name="TransactionText"
                            Text="自动提交"
                            FontSize="{StaticResource Size.FontStatus}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="SessionText"
                            Text="未连接"
                            TextTrimming="CharacterEllipsis"
                            FontSize="{StaticResource Size.FontStatus}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="RefreshAgeText"
                            Text="Last Refresh: —"
                            FontSize="{StaticResource Size.FontStatus}"
                            Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>