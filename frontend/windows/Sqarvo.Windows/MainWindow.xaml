<?xml version="1.0" encoding="utf-8"?>
<!--
    #163 的主窗口：外壳条 / 工具条 / 可重建的页面宿主 / 状态栏。

    尺寸仍然只来自 {StaticResource Size.*}（构建期生成），Padding 这类结构体在 code-behind
    从 Metrics 取。窗口尺寸、DPI 变化、最小尺寸、密度档全部走 MainWindow.Relayout()。
-->
<Window
    x:Class="Sqarvo.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sqarvo">

    <Grid x:Name="RootGrid" Background="{ThemeResource SqarvoAppBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnTierReset" />
            <!-- 规范要求 Ctrl+Plus / Ctrl+KeyPadAdd：Add/Subtract 是数字键盘。主键盘的 = 与 -
                 是 OEM 键（187/189），VirtualKey 枚举里没有名字，只能在 code-behind 里按数值加，
                 见 MainWindow.RegisterTierAccelerators()。 -->
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="OnTierUp" />
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="OnTierDown" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeaderBand"
            Grid.Row="0"
            Background="{ThemeResource SqarvoSurfaceBrush}"
            Height="{StaticResource Size.HeaderHeight}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="{StaticResource Size.ToolbarPaddingH}"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Sqarvo"
                        FontSize="{StaticResource Size.FontTitle}"
                        Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TierText"
                        FontSize="{StaticResource Size.FontStatus}"
                        Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    x:Name="ThemeText"
                    Grid.Column="1"
                    FontSize="{StaticResource Size.FontStatus}"
                    Foreground="{ThemeResource SqarvoAccentTextBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border
            x:Name="ToolbarBand"
            Grid.Row="1"
            Background="{ThemeResource SqarvoBandBrush}"
            Height="{StaticResource Size.ToolbarHeight}">
            <TextBlock
                x:Name="ToolbarText"
                FontSize="{StaticResource Size.FontUi}"
                Foreground="{ThemeResource SqarvoTextPrimaryBrush}"
                VerticalAlignment="Center" />
        </Border>

        <!-- 页面宿主：切密度档时整页在这里被替换（重建，不热切）。 -->
        <Border
            x:Name="PageHostBorder"
            Grid.Row="2"
            Background="{ThemeResource SqarvoSurfaceBrush}"
            BorderBrush="{ThemeResource SqarvoCardBorderBrush}">
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>

        <Grid
            x:Name="StatusBand"
            Grid.Row="3"
            Height="{StaticResource Size.StatusHeight}"
            Background="{ThemeResource SqarvoBandBrush}">
            <TextBlock
                x:Name="StatusText"
                FontSize="{StaticResource Size.FontStatus}"
                Foreground="{ThemeResource SqarvoTextSecondaryBrush}"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>