<?xml version="1.0" encoding="utf-8"?>
<!--
    主题 token（颜色）与尺寸引用。

    两条硬约束（AGENTS.md §8.2、docs/ui-specification/scaling-and-window-sizing.md §8）：

    1. 颜色只用系统 ThemeResource，**这里不出现任何 #RRGGBB**：写死一处就放弃高对比与
       系统强调色跟随（换主题时那几个像素不会变，而且没人会去查）。
    2. 尺寸不在 XAML 里写字面量：`Size.*` 由 frontend/windows/tools/gen-metrics.ps1 从
       docs/ui-specification/metrics.toml 生成到 Metrics.g.cs，运行时由
       Theming/MetricsResources.cs 写进 Application.Resources。页面只引用键名。

    三套 ThemeDictionaries（Default / Light / Dark / HighContrast）里的别名值全部指向系统
    token，因此高对比下自动走系统色——不存在「我们有自己的一套高对比色板」这回事。

    §Sqarvo 控件别名 这一组是 WinUI 的 lightweight styling 键（形状就是「StaticResource 别名：
    键名 = 控件属性名，值 = 系统 token」）。它们只表达两件事：

      a) 禁用态与说明文字**同一种灰**（TextFillColorSecondaryBrush）：状态栏行操作与
         「尚未…」说明爬同一个颜色，状态栏里不会出现第三档灰（workspace-model §7）。
      b) 种类入口的 tab 形态：未选中 = 透明底 + 主文字色，悬停 = 轻微填充，
         选中 = 轻微填充 + 强调色文字（对应 Linux 的「当前种类」高亮）。

    这些键都是「找不到就退回框架默认值」的，写错不会崩，只会少一点样式——所以宁可把它们
    集中在这里，也别散在各页的 Resources 里。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- 默认：跟随当前系统主题 -->
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="SqarvoAppBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
            <StaticResource x:Key="SqarvoSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoBandBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoDividerBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <!-- 工具条竖分隔线专用：CardStroke 在浅色底上仍低于可见阈值（1px 竖线在真机上看不见）。 -->
            <StaticResource x:Key="SqarvoDividerStrongBrush" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="SqarvoTextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTextSecondaryBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoAccentTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!-- 主操作（工具条的「连接」）：系统强调色填充 + 反白文字。
                 用别名而不是直写 AccentFillColorDefaultBrush，是为了让 XAML 只认 Sqarvo* 这一组键，
                 换主题/高对比时统一由 ThemeDictionaries 接管。 -->
            <StaticResource x:Key="SqarvoAccentFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoOnAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <!-- 列表选中行底色（Objects 页三列表格；与数据网格同一档浅底） -->
            <StaticResource x:Key="SqarvoSelectionBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <!-- 拼装 DDL 的警示（exact=false）：琥珀，系统 token，不写死颜色 -->
            <StaticResource x:Key="SqarvoWarningTextBrush" ResourceKey="SystemFillColorCautionBrush" />

            <!-- 禁用文字 = 说明文字（同一种灰） -->
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextFillColorSecondaryBrush" />

            <!-- 种类入口：未选中 = 透明底 + 主文字；悬停 = 轻微填充；选中 = 轻微填充 + 强调色文字 -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="SqarvoAppBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
            <StaticResource x:Key="SqarvoSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoBandBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoDividerBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <!-- 工具条竖分隔线专用：CardStroke 在浅色底上仍低于可见阈值（1px 竖线在真机上看不见）。 -->
            <StaticResource x:Key="SqarvoDividerStrongBrush" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="SqarvoTextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTextSecondaryBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoAccentTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!-- 主操作（工具条的「连接」）：系统强调色填充 + 反白文字。
                 用别名而不是直写 AccentFillColorDefaultBrush，是为了让 XAML 只认 Sqarvo* 这一组键，
                 换主题/高对比时统一由 ThemeDictionaries 接管。 -->
            <StaticResource x:Key="SqarvoAccentFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoOnAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SqarvoSelectionBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoWarningTextBrush" ResourceKey="SystemFillColorCautionBrush" />

            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextFillColorSecondaryBrush" />

            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="SqarvoAppBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
            <StaticResource x:Key="SqarvoSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoBandBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoDividerBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <!-- 工具条竖分隔线专用：CardStroke 在浅色底上仍低于可见阈值（1px 竖线在真机上看不见）。 -->
            <StaticResource x:Key="SqarvoDividerStrongBrush" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="SqarvoTextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTextSecondaryBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoAccentTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!-- 主操作（工具条的「连接」）：系统强调色填充 + 反白文字。
                 用别名而不是直写 AccentFillColorDefaultBrush，是为了让 XAML 只认 Sqarvo* 这一组键，
                 换主题/高对比时统一由 ThemeDictionaries 接管。 -->
            <StaticResource x:Key="SqarvoAccentFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoOnAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SqarvoSelectionBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoWarningTextBrush" ResourceKey="SystemFillColorCautionBrush" />

            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextFillColorSecondaryBrush" />

            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>

        <!-- 高对比：同样指向系统 token，系统会替换成高对比色板 -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SqarvoAppBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
            <StaticResource x:Key="SqarvoSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoBandBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoDividerBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <!-- 工具条竖分隔线专用：CardStroke 在浅色底上仍低于可见阈值（1px 竖线在真机上看不见）。 -->
            <StaticResource x:Key="SqarvoDividerStrongBrush" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="SqarvoTextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTextSecondaryBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SqarvoAccentTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!-- 主操作（工具条的「连接」）：系统强调色填充 + 反白文字。
                 用别名而不是直写 AccentFillColorDefaultBrush，是为了让 XAML 只认 Sqarvo* 这一组键，
                 换主题/高对比时统一由 ThemeDictionaries 接管。 -->
            <StaticResource x:Key="SqarvoAccentFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SqarvoOnAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="SqarvoTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />

            <!-- 高对比下选中行用系统高亮色，警示仍走系统 token -->
            <StaticResource x:Key="SqarvoSelectionBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SqarvoWarningTextBrush" ResourceKey="SystemFillColorCautionBrush" />

            <!-- 高对比下不做「同一种灰」的收拢：禁用态必须与正文有足够对比度差，交给系统 -->
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

            <!-- 高对比下选中态只用系统高亮色，不靠浅填充 -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="SystemColorHighlightTextColorBrush" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>